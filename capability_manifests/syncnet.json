{
  "detector_name": "syncnet",
  "modality": [
    "video"
  ],
  "version": "syncnet-v1",
  "description": "Checks lip-movement to audio alignment to detect lip-sync deepfakes and dubbing.",
  "input_constraints": {
    "requires_audio": true,
    "min_duration_seconds": 1.0,
    "max_duration_seconds": null,
    "supported_formats": [
      ".mp4",
      ".mov"
    ]
  },
  "performance": {
    "avg_latency_ms": null,
    "p95_latency_ms": null,
    "avg_ram_usage_mb": null,
    "avg_vram_usage_mb": null,
    "measured_on": "PENDING \u2014 awaiting Task #1 benchmark report"
  },
  "known_failure_modes": [
    {
      "condition": "silent video (no audio track)",
      "effect": "not applicable \u2014 must be excluded by orchestrator rules, cannot run",
      "source": "Task #2 spec"
    },
    {
      "condition": "clip shorter than 2 seconds",
      "effect": "handled gracefully via sliding window guardrail, returns not_applicable rather than an error",
      "source": "docs/failure_notes.md, Week 3 edge-case validation"
    },
    {
      "condition": "severely underexposed / poorly lit video",
      "effect": "zero lip sequences extracted, returns not_applicable",
      "source": "docs/failure_notes.md, Week 3 edge-case validation"
    },
    {
      "condition": "partially occluded face (mouth/lower face covered)",
      "effect": "lip sync analysis skipped gracefully, returns not_applicable",
      "source": "docs/failure_notes.md, Week 3 edge-case validation"
    }
  ],
  "reliability_notes": "Only meaningful for video with a clear, unoccluded face and audio track; never call on silent, audio-only, dark, or occluded-face inputs \u2014 the detector itself returns not_applicable in these cases rather than a misleading score.",
  "authority_tier": "primary",
  "base_reliability_weight": 1.2,
  "calibration": {
    "modality": "audiovisual",
    "preferred_method": "temperature",
    "checkpoint": null
  },
  "condition_reliability": {
    "nominal": {
      "requires_audio": true,
      "min_luminance": 18.0,
      "weight_multiplier": 1.0,
      "confidence_damping": 1.0
    },
    "silent_audio_absent": {
      "requires_audio": true,
      "advisory_when_primary_visual_active": true
    },
    "foreign_dubbing_risk": {
      "weight_multiplier": 0.4,
      "confidence_damping": 0.5
    },
    "severe_dark_or_face_lost": {
      "min_luminance": 18.0,
      "fatal_if_violated": true
    }
  }
}
