# AEGIS Environment Variables
# Copy this file to .env and fill in the values below. DO NOT COMMIT .env TO GITHUB.

# ---------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------
# The orchestrator requires this key for all incoming requests.
# Generate a strong random string for production.
INTERNAL_API_KEY=your_secure_token_here

# ---------------------------------------------------------
# Security Subsystem Operation Profiles
# ---------------------------------------------------------
# Set to "prod" for strict zero-trust enforcement (pentesting/advisor presentation)
# Set to "dev" for permissive AI and web developer sandbox (audit warnings, no socket drops)
AEGIS_SECURITY_PROFILE=prod
AEGIS_TELEMETRY_PORT=8444
