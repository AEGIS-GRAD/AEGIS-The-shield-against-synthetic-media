{
  "detector_name": "video-classifier",
  "modality": [
    "video"
  ],
  "version": "xception-ff++-v1",
  "description": "Frame-level classifier detecting face-swap and reenactment deepfakes using Xception.",
  "input_constraints": {
    "requires_audio": false,
    "min_duration_seconds": 0.1,
    "max_duration_seconds": null,
    "supported_formats": [
      ".mp4",
      ".mov",
      ".jpg",
      ".png"
    ]
  },
  "performance": {
    "avg_latency_ms": null,
    "p95_latency_ms": null,
    "avg_ram_usage_mb": null,
    "avg_vram_usage_mb": null,
    "measured_on": "PENDING \u2014 awaiting Task #1 benchmark report"
  },
  "known_failure_modes": [
    {
      "condition": "heavily compressed/re-encoded video",
      "effect": "reduced accuracy, per project problem statement",
      "source": "docs/failure_notes.md"
    }
  ],
  "reliability_notes": "Most reliable primary signal; use as default detector for any video/image input.",
  "authority_tier": "primary",
  "base_reliability_weight": 1.5,
  "calibration": {
    "modality": "video",
    "preferred_method": "temperature",
    "checkpoint": "eval/calibration/checkpoints/video_temperature_calibrator.json"
  },
  "condition_reliability": {
    "nominal": {
      "min_luminance": 40.0,
      "min_duration": 2.0,
      "weight_multiplier": 1.0,
      "confidence_damping": 1.0
    },
    "low_light_lum_lt_40": {
      "max_luminance": 40.0,
      "weight_multiplier": 0.65,
      "confidence_damping": 0.8
    },
    "severe_dark_lum_lt_18": {
      "max_luminance": 18.0,
      "weight_multiplier": 0.35,
      "confidence_damping": 0.5
    },
    "short_clip_lt_2s": {
      "max_duration": 2.0,
      "weight_multiplier": 0.55,
      "confidence_damping": 0.7
    },
    "heavy_compression_lt_500kbps": {
      "max_bitrate_kbps": 500.0,
      "weight_multiplier": 0.55,
      "confidence_damping": 0.75
    },
    "no_face_detected": {
      "requires_face": true,
      "fatal_if_missing": true
    }
  }
}
